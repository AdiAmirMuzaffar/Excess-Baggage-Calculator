<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About Application"
        android:textColor="@color/primary_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Developer Details:"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Name: Adi Amir Ikram Bin Muzaffar\n• Group: RCS2515B\n• Student Number: 2025243706\n• Programme Code: ICT602" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Project Repository:"
        android:textStyle="bold" />

    <!-- Clickable URL linking to GitHub -->
    <TextView
        android:id="@+id/tvGithubUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="web"
        android:text="https://github.com/AdiAmirMuzaffar/Excess-Baggage-Calculator.git"
        android:textColor="@color/primary_blue" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="© 2026 Excess Baggage Calculator. All rights reserved to the developer."
        android:textSize="12sp" />
</LinearLayout>